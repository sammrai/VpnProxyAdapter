OPENVPN_USERNAME=your_username
OPENVPN_PASSWORD=your_password
# Folder name in notFloran/vpn-configs-contrib/openvpn (default: expressvpn)
# OPENVPN_PROVIDER=expressvpn
# Total exits = host 1 + VPN tunnels. Keep tunnels within the provider's connection limit (default: 20)
# GATEWAY_EXITS=20
# Regions to prefer, comma separated. Exact file name or part of it
# REGIONS=japan,singapore
